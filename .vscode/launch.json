{
    // veja mais em: https://code.visualstudio.com/docs/java/java-debugging
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ContratoqueryApplication",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "br.com.srportto.contratoquery.ContratoqueryApplication",
            "projectName": "contratoquery",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "Spring Boot-ContratoqueryApplication",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "br.com.srportto.contratoquery.ContratoqueryApplication",
            "projectName": "contratoquery",
            "args": "",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "GeraDatasPorParticao",
            "request": "launch",
            "mainClass": "br.com.srportto.contratocommand.domain.utilities.GeraDatasPorParticao",
            "projectName": "contratocommand"
        },
        {
            "type": "java",
            "name": "Debug (Launch) - Current File",
            "request": "attach",
            "hostName": "localhost",
            "port": "<debug port of the debuggee>"
        },
        {
            "type": "java",
            "name": "ContratocommandApplication",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "br.com.srportto.contratocommand.ContratocommandApplication",
            "projectName": "contratocommand",
            "envFile": "${workspaceFolder}/.env",
            "stepFilters": {
                "skipClasses": [
                    "$JDK",
                    "junit.*"
                ],
                "skipSynthetics": false,
                "skipStaticInitializers": false,
                "skipConstructors": false
            }
        },
        {
            "type": "java",
            "name": "Spring Boot-ContratocommandApplication",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "br.com.srportto.contratocommand.ContratocommandApplication",
            "projectName": "contratocommand",
            "args": "",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}