# Copie para .env (git-ignorado) e ajuste o valor antes de `docker compose -f postgres-db-v18.yml up -d`.
# Sem DB_PASSWORD definida, a subida falha com erro explicito (nao ha mais valor padrao).
# Use a MESMA senha configurada em apps/.env, caso os dois ambientes apontem para o mesmo Postgres.

DB_PASSWORD=<defina-sua-senha-local>
