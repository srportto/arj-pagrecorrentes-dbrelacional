<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>br.com.srportto</groupId>
	<artifactId>srportto-commons-java</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<name>srportto-commons-java</name>
	<description>Biblioteca Java pura de utilitarios compartilhados entre apps do monorepo (sem Spring/Jakarta).</description>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<junit.version>5.11.0</junit.version>
	</properties>

	<!-- Java puro: nenhuma dependencia de escopo compile fora de java.*. JUnit fica restrito ao escopo test. -->
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- Distribuicao no GitHub Packages do proprio repositorio (D5 do design.md da change criar-lib-utilitarios-java) -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages - arj-pagrecorrentes-dbrelacional</name>
			<url>https://maven.pkg.github.com/srportto/arj-pagrecorrentes-dbrelacional</url>
		</repository>
	</distributionManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>${maven.compiler.release}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>
		</plugins>
	</build>

</project>
